<Window x:Class="MyFences.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyFences" Width="380" Height="340"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" MinWidth="220" MinHeight="42"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFCBD5E1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#405B6D85" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#606C8099" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResizeThumb" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Border x:Name="Surface" CornerRadius="10" Background="{StaticResource PanelBrush}" BorderBrush="#557B91B3" BorderThickness="1" Margin="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="Header" Background="#30FFFFFF" CornerRadius="9,9,0,0" Padding="13,0,8,0"
                MouseLeftButtonDown="Header_Down" MouseMove="Header_Move" MouseLeftButtonUp="Header_Up" LostMouseCapture="Header_LostCapture">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="7" Height="7" Background="#FF78B8FF" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock x:Name="TitleText" Foreground="#FFF2F6FC" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Left" ToolTip="Двойной клик — переименовать. Потяните, чтобы переместить." MouseLeftButtonDown="Title_Down" />
              <TextBox x:Name="TitleEditor" Visibility="Collapsed" FontSize="13" MaxLength="100" Padding="3,1"
                       KeyDown="TitleEditor_KeyDown" LostKeyboardFocus="TitleEditor_LostFocus" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="RollButton" Style="{StaticResource HeaderButton}" Content="⌃" ToolTip="Свернуть / развернуть" Click="Roll_Click" />
              <Button Style="{StaticResource HeaderButton}" Content="⋯" FontSize="18" ToolTip="Меню блока" Click="Menu_Click" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid x:Name="Body" Grid.Row="1" Margin="5,7,5,0">
          <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Foreground="White"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.CanContentScroll="False" SelectionMode="Single" MouseDoubleClick="Items_DoubleClick" PreviewMouseRightButtonUp="Items_RightClick">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Width" Value="86" /><Setter Property="Height" Value="97" />
                <Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template"><Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#287EB5FF" /></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#387EB5FF" /><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#707EB5FF" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid ToolTip="{Binding Path}">
                <Grid.RowDefinitions><RowDefinition Height="53" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Image Source="{Binding Icon}" Width="44" Height="44" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#FFE9EEF8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="31" />
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
            <TextBlock Text="＋" Foreground="#FF6C8BAD" FontSize="32" HorizontalAlignment="Center" />
            <TextBlock Text="Перетащите сюда файлы" Foreground="#FFB1BED0" FontSize="13" HorizontalAlignment="Center" Margin="0,5,0,4" />
            <TextBlock Text="Они будут перемещены в папку блока" Foreground="#FF7E90A8" FontSize="10" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Border x:Name="Footer" Grid.Row="2" Padding="13,7,13,10">
          <DockPanel>
            <TextBlock x:Name="CountText" Foreground="#FF8699B2" FontSize="10" />
            <TextBlock Text="MYFENCES" HorizontalAlignment="Right" Foreground="#FF5E7696" FontSize="9" FontWeight="SemiBold" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Border x:Name="DropOverlay" Visibility="Collapsed" Margin="2" Background="#E0253E5D" BorderBrush="#FF8EC5FF" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="40" Foreground="White" HorizontalAlignment="Center" /><TextBlock Text="Переместить в этот блок" Foreground="White" FontSize="14" /></StackPanel>
    </Border>
    <Thumb Style="{StaticResource ResizeThumb}" Tag="L" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="R" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="T" Height="5" VerticalAlignment="Top" Cursor="SizeNS" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="B" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="LT" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="RT" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="LB" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
    <Thumb Style="{StaticResource ResizeThumb}" Tag="RB" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="Resize_Start" DragDelta="Resize_Delta" DragCompleted="Resize_End" />
  </Grid>
</Window>
